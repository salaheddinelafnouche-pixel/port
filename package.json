{
  "name": "por-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "lint": "tsc",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "nodemailer": "^10.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.6"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.9",
    "qs": "6.16.1",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "esbuild": "0.28.1"
  }
}
